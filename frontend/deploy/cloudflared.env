# Cloudflare Tunnel 配置模板
# 使用方法：
# 1. 复制为 cloudflared.env
# 2. 按实际情况填写
# 3. 重新执行 start-local-publish.sh

# quick: 临时 trycloudflare 地址
# named: 固定 tunnel + 固定域名，推荐答辩和正式展示使用
# 在你拿到 Cloudflare Zero Trust token 之前，先保持 quick
CLOUDFLARE_TUNNEL_MODE=quick

# Cloudflare Zero Trust / Tunnel 页面复制的 token
CLOUDFLARE_TUNNEL_TOKEN=

# 你后面准备绑定的固定公网域名
PUBLIC_TUNNEL_URL=https://voice.baconboat.cn
